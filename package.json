    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "semantic-release": "25.0.9",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
