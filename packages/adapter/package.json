{
  "name": "@usecontextlayer/pi-durable-assistant-ui",
  "version": "0.0.0-development",
  "license": "MIT",
  "description": "Assistant UI runtime adapter for Pi Durable conversations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecontextlayer/pi-durable-assistant-ui.git",
    "directory": "packages/adapter"
  },
  "homepage": "https://github.com/usecontextlayer/pi-durable-assistant-ui#readme",
  "bugs": {
    "url": "https://github.com/usecontextlayer/pi-durable-assistant-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.32",
    "react": "^19.0.0",
    "@earendil-works/pi-durable": "^1.5.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.32",
    "react": "19.3.1",
    "@earendil-works/pi-durable": "1.5.0"
  }
}
